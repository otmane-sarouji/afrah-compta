{
  "name": "afrah-compta",
  "version": "1.1.0",
  "description": "AFRAH COMPTA — gestion commerciale et comptable",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "author": "AFRAH",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ma.afrah.compta",
    "productName": "AFRAH COMPTA",
    "files": [
      "electron/**/*",
      "www/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AFRAH COMPTA"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
